{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "merge-arena",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public" },

  // Artifacts 绑定：namespace "merge-arena"（需 Workers Paid plan，Dashboard 或 API 预先创建）
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "merge-arena" }],

  // 路径 A（推荐）：Artifacts 事件直触发，无需 Queue。
  // 需要 wrangler >= 4.118；filter 键名以 `npx wrangler types` / 部署校验为准。
  // workflow 目标示例（按需启用）：
  //   "workflows": [{ "name": "review-workflow", "binding": "REVIEW_WORKFLOW", "class_name": "ReviewWorkflow" }],
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "merge-arena", "repo_name": "arena-*" }
        // "workflow": "review-workflow"
      }
    ]
  }

  // 路径 B（兜底）：经典 Queue 消费事件。若 direct triggers 不可用，
  // 取消下面注释，用 queue 接收 cf.artifacts.repo.pushed，src/index.ts 的
  // queue() 消费者已实现（与 direct triggers 共用 handlePushEvent）。
  // , "queues": {
  //     "producers": [{ "queue": "arena-events", "binding": "ARENA_EVENTS" }],
  //     "consumers": [{ "queue": "arena-events", "dead_letter_queue": "arena-events-dlq" }]
  //   }
}
